# cloudsync 配置示例 —— 复制为 cloudsync.yaml 并填入自己的值。
# 密钥用 ${ENV_VAR} 形式从环境变量读取，不要明文写入仓库。
targets:
  # Cloudflare KV（服务端见 server/cf-worker）
  cf:
    type: cfkv
    base_url: https://cf-workers-text2kv-aec.pages.dev
    token: ${CLOUDSYNC_CF_TOKEN}
    filename_prefix: sub/          # 可选：所有 key 加前缀
    verify: true                   # 可选：默认 true（回读校验）

  # EdgeOne KV（服务端见 server/edgeone-kv）
  edge:
    type: edgeone-kv               # 或 edgeone-blob
    base_url: https://my-project.edgeone.app
    token: ${CLOUDSYNC_EO_TOKEN}

  # EdgeOne Blob（保留目录/原文件名，服务端见 server/edgeone-blob）
  daily:
    type: edgeone-blob
    base_url: https://my-project.edgeone.app
    bucket: subs                    # 可选：所有 key 放到该目录下

  # 也可以不写 token，推送时会报清晰的错误提示
  readonly:
    type: edgeone-kv
    base_url: https://my-project.edgeone.app
